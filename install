#!/bin/sh
# Symlink dotfiles into place. Safe to re-run.
set -e
cd "$(dirname "$0")"

link() {
	mkdir -p "$(dirname "$2")"
	ln -sfn "$PWD/$1" "$2"
	echo "$2 -> $1"
}

# ~/.zshrc is per-machine and not in this repo, so add the source line to it.
source_from_zshrc() {
	grep -qs "$1" ~/.zshrc || printf '%s\n' "[ -f ~/.config/zsh/$1 ] && . ~/.config/zsh/$1" >>~/.zshrc
	echo "~/.zshrc sources $1"
}

link git/config ~/.config/git/config
link tmux/tmux.conf ~/.config/tmux/tmux.conf
link bin/urlencode ~/.local/bin/urlencode

# Hammerspoon is macOS-only. Link the files, not the directory, so Spoons it
# installs into ~/.hammerspoon stay on the machine and out of this repo.
if [ "$(uname)" = Darwin ]; then
	for lua in hammerspoon/*.lua; do
		link "$lua" "$HOME/.hammerspoon/${lua#hammerspoon/}"
	done
fi

# Config for whichever shell this account uses. shell/aliases is one file,
# valid in both fish and zsh; they just load it from different places.
# Keybindings are zsh-only -- fish already binds ^A and friends.
case "${SHELL##*/}" in
fish)
	link shell/aliases ~/.config/fish/conf.d/dotfiles-aliases.fish
	;;
zsh)
	link shell/aliases ~/.config/zsh/dotfiles-aliases.zsh
	link zsh/keybindings ~/.config/zsh/dotfiles-keybindings.zsh
	link zsh/history ~/.config/zsh/dotfiles-history.zsh
	source_from_zshrc dotfiles-aliases.zsh
	source_from_zshrc dotfiles-keybindings.zsh
	source_from_zshrc dotfiles-history.zsh
	;;
*)
	echo "\$SHELL is ${SHELL:-unset}, not fish or zsh; skipped shell config" >&2
	;;
esac

# Identity lives in ~/.gitconfig, per machine, never in this repo. Create it
# first: while it's missing, `git config --global` writes into the symlink
# above instead, i.e. into this repo.
[ -f "$HOME/.gitconfig" ] || touch "$HOME/.gitconfig"
git config --global user.name "Mathew Button"

if ! git config --global --get user.email >/dev/null; then
	printf "git email for this machine: "
	read -r email
	[ -n "$email" ] && git config --global user.email "$email"
fi
